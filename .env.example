# Kopiraj u .env.local (ignorisan u gitu) i popuni stvarne vrednosti. Nikad ne commit-uj prave kljuceve.
# Koristi se samo na serveru (nikad NEXT_PUBLIC_ / VITE_ prefiks).

DSCORE_API_URL=https://new-api.dscore.live
DSCORE_API_KEY=

KSSLIVE_USERNAME=
KSSLIVE_PASSWORD=
# Backend racuna: Authorization: Bearer base64(KSSLIVE_USERNAME:KSSLIVE_PASSWORD)

# Samo za lokalni seed (npm run seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
